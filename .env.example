# At least one provider key. Placeholder values are treated as unset.

# OpenRouter — one key, many models (recommended for cross-model benches)
OPENROUTER_API_KEY=sk-or-...

# Direct providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
XAI_API_KEY=xai-...
GOOGLE_API_KEY=...
DEEPSEEK_API_KEY=sk-...

# Explicit roster (comma-separated litellm ids). Overrides auto-discovery order.
# HOOKSET_MODELS=xai/grok-4.6,gpt-5.6-terra,claude-sonnet-5,gemini/gemini-3.7-flash

# Legacy alias still honored
# MTP_MODELS=gpt-5.6-terra,xai/grok-4.6
